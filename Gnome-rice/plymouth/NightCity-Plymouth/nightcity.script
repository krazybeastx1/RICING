# NIGHT CITY — Plymouth boot script
# Requires the plymouth "script" plugin. No external binaries, no network.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

background = Image("background.png");
background = background.Scale(screen_width, screen_height);
background_sprite = Sprite(background);
background_sprite.SetPosition(0, 0, -100);

logo = Image("logo.png");
logo_width = screen_width * 0.46;
logo_height = logo.GetHeight() * (logo_width / logo.GetWidth());
logo = logo.Scale(logo_width, logo_height);
logo_sprite = Sprite(logo);
logo_sprite.SetPosition((screen_width - logo_width) / 2, screen_height * 0.22, 10);

track = Image("progress-track.png");
track_width = screen_width * 0.32;
track_height = 4;
track = track.Scale(track_width, track_height);
track_sprite = Sprite(track);
track_sprite.SetPosition((screen_width - track_width) / 2, screen_height * 0.70, 10);

pip = Image("progress-pip.png");
pip_width = screen_width * 0.055;
pip_height = 4;
pip = pip.Scale(pip_width, pip_height);
pip_sprite = Sprite(pip);
pip_sprite.SetPosition((screen_width - track_width) / 2, screen_height * 0.70, 11);

status = Image.Text("RED LINE // INITIALISING", 0.57, 0.60, 0.66, 1.0);
status_sprite = Sprite(status);
status_sprite.SetPosition((screen_width - status.GetWidth()) / 2, screen_height * 0.75, 10);

progress = 0.0;

fun boot_progress_callback(p) {
    progress = p;
}

fun message_callback(text) {
    status = Image.Text(text, 0.57, 0.60, 0.66, 1.0);
    status_sprite.SetImage(status);
    status_sprite.SetPosition((screen_width - status.GetWidth()) / 2, screen_height * 0.75, 10);
}

fun refresh_callback() {
    travel = track_width - pip_width;
    x = (screen_width - track_width) / 2 + travel * progress;
    pip_sprite.SetPosition(x, screen_height * 0.70, 11);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetRefreshFunction(refresh_callback);

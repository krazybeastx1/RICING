# NIGHT CITY — dconf configuration dump for GNOME Shell extensions
# Generated by the NightCity project. Apply with: dconf load / < night-city.dconf
# Only applies to schemas that exist; missing extensions are ignored by dconf.

# ============================================================================
# Blur My Shell — blur-my-shell@aunetx
# ============================================================================
[org/gnome/shell/extensions/blur-my-shell]
panel-blur=true
panel-blur-radius=12
panel-blur-brightness=0.8
panel-blur-sigma=30
panel-blur-noise=0.02
panel-tint=true
panel-tint-color='#FF1744'
panel-tint-opacity=0.08
overview-blur=true
overview-blur-radius=20
overview-blur-brightness=0.6
overview-blur-sigma=40
window-blur=false
app-folder-blur=false

# ============================================================================
# Just Perfection — just-perfection-desktop@shell-extensions.gcampus.dev
# ============================================================================
[org/gnome/shell/extensions/just-perfection]
activities-button=true
app-menu=true
clock-position='CENTER'
workspace-popup=false
window-demands-attention-focus=false
panel-size=32
hot-corner=false

# ============================================================================
# Dash to Dock — dash-to-dock@micxgx.gmail.com
# ============================================================================
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
custom-background-color=true
background-color='#08090D'
background-opacity=0.90
running-indicator-style='DOTS'
running-indicator-dominant-color=false
custom-theme-customize-running-dots=true
custom-theme-running-dots-color='#FF1744'
custom-theme-running-dots-border-color='#FF1744'
custom-theme-running-dots-border-width=1
dash-max-icon-size=40
click-action='minimize'
scroll-action='cycle-windows'
autohide=true
intellihide=true
show-trash=false
show-mounts=false

# ============================================================================
# User Themes — user-theme@gnome-shell-extensions.gcampax.github.com
# ============================================================================
[org/gnome/shell/extensions/user-theme]
name='NightCity-Shell'

# ============================================================================
# Core GNOME Shell settings (not extension-specific)
# ============================================================================
[org/gnome/shell]
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com']

[org/gnome/desktop/interface]
gtk-theme='NightCity-GTK'
icon-theme='NightCity-Icons'
cursor-theme='NightCity-Cursor'
cursor-size=24
color-scheme='prefer-dark'
accent-color='red'
enable-animations=true
font-name='Space Grotesk 10.5'
document-font-name='Space Grotesk 11'
monospace-font-name='JetBrains Mono 10.5'

[org/gnome/desktop/wm/preferences]
titlebar-font='Rajdhani Bold 10.5'
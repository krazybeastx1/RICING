[Icon Theme]
Name=NightCity-Icons
Comment=NIGHT CITY — neon-red cyberpunk icon theme
Inherits=Adwaita,hicolor
Example=utilities-terminal

Directories=apps/scalable,64x64/apps,128x128/apps,256x256/apps,places/scalable,64x64/places,128x128/places,256x256/places,categories/scalable,64x64/categories,128x128/categories,256x256/categories

